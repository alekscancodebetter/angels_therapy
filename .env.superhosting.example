APP_NAME="Angel Touch Therapy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://angeltouchtherapy.co.uk
CANONICAL_URL=https://angeltouchtherapy.co.uk
APP_TIMEZONE=Europe/London
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nikkiebl_AngelTouchTherapy_New
DB_USERNAME=nikkiebl_bd_admin
DB_PASSWORD="CHANGE_ME_PASSWORD"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=angel_touch_production_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=angel_touch_production_cache
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
DB_QUEUE_AFTER_COMMIT=true
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.angeltouchtherapy.co.uk
MAIL_PORT=465
MAIL_USERNAME=contact@angeltouchtherapy.co.uk
MAIL_PASSWORD="CHANGE_ME_MAIL_PASSWORD"
MAIL_EHLO_DOMAIN=angeltouchtherapy.co.uk
MAIL_FROM_ADDRESS=contact@angeltouchtherapy.co.uk
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS=contact@angeltouchtherapy.co.uk
MAIL_REPLY_TO_NAME="${APP_NAME}"
MAIL_BUSINESS_RECIPIENTS="contact@angeltouchtherapy.co.uk,Violina1912@gmail.com"

# Optional fallback values. Once saved in Admin > Settings, database values take precedence.
GOOGLE_TRACKING_MODE=direct

APP_NAME="Angel Touch Therapy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://experiment.angeltouchtherapy.co.uk
CANONICAL_URL=https://experiment.angeltouchtherapy.co.uk
APP_TIMEZONE=Europe/London
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME_DATABASE
DB_USERNAME=CHANGE_ME_USERNAME
DB_PASSWORD="CHANGE_ME_PASSWORD"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=angel_touch_experiment_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=angel_touch_experiment_cache
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@angeltouchtherapy.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

# Optional fallback values. Once saved in Admin > Settings, database values take precedence.
GOOGLE_TRACKING_MODE=direct
GOOGLE_TAG_ID=
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_TAG_MANAGER_CONTAINER_ID=
GOOGLE_ADS_TAG_ID=
GOOGLE_ADS_BOOKING_CONVERSION_LABEL=
GOOGLE_ADS_BOOKING_CONVERSION_VALUE=
GOOGLE_ADS_BOOKING_CONVERSION_CURRENCY=GBP
GOOGLE_ADS_PHONE_CONVERSION_LABEL=
GOOGLE_ADS_PHONE_CONVERSION_VALUE=1
GOOGLE_ADS_PHONE_CONVERSION_CURRENCY=GBP
META_PIXEL_ID=
META_ADS_BOOKING_EVENT_NAME=Schedule
META_ADS_BOOKING_VALUE=
META_ADS_BOOKING_CURRENCY=GBP
META_ADS_PHONE_EVENT_NAME=Contact
META_ADS_PHONE_VALUE=
META_ADS_PHONE_CURRENCY=GBP
